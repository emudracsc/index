{
  "manifest_version": 3,
  "name": "Excel Auto Checkbox Filler | एक्सेल ऑटो चेकबॉक्स सिलेक्टर",
  "version": "1.0.0",
  "description": "वेब पेजवरील टेबलमधील डेटाच्या पुढील चेकबॉक्स एक्सेल फाईल (.xlsx/.csv) अपलोड करून आपोआप सिलेक्ट किंवा अनसिलेक्ट (Checked/Unchecked) करा.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "एक्सेल ऑटो चेकबॉक्स सिलेक्टर",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/xlsx.full.min.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/xlsx.full.min.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
