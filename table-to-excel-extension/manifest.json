{
  "manifest_version": 3,
  "name": "Table Copy & Checkbox | टेबल ऑटो चेक",
  "version": "1.2.0",
  "description": "वेब पेजवरील टेबल १-क्लिकमध्ये कॉपी/एक्सेल करा आणि एक्सेल अपलोड करून टेबलमधील चेकबॉक्स आपोआप भरा.",
  "browser_specific_settings": {
    "gecko": {
      "id": "table-to-excel@emudracsc.in",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "१-क्लिक टेबल कॉपी व एक्सेल एक्सपोर्टर",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/xlsx.full.min.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/xlsx.full.min.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
